# Copier ce fichier en `.env` (jamais versionné) et renseigner les valeurs.
# Une valeur brute par ligne : pas de guillemets nécessaires, pas de code Python.

# --- Application ---
APP_ENV=dev                      # dev | prod (en prod, les secrets ci-dessous sont obligatoires)
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# --- LLM (Groq) : un modèle fixe pour tout le projet ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b   # alternative d'urgence : openai/gpt-oss-20b

# --- Données football (football-data.org) ---
FOOTBALL_DATA_API_KEY=

# --- Supabase (base PostgreSQL + authentification) ---
DATABASE_URL=                    # chaîne « Session pooler » du tableau de bord Supabase
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=10

# --- Quotas et limites (valeurs initiales mesurées en phase 0) ---
USER_DAILY_MESSAGES=10
GLOBAL_DAILY_TOKENS=170000       # ≈ 85 % du plafond Groq de 200 000 tokens/jour
MAX_MESSAGE_CHARS=2000
HISTORY_MAX_MESSAGES=4
MAX_COMPLETION_TOKENS=1500
